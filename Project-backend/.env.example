# Runtime
NODE_ENV=development
PORT=3000

# PostgreSQL
# Local PostgreSQL normally does not support SSL.
# For deployment, set DATABASE_URL and DB_SSL=true only when your host requires SSL.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/tradingDB
# DB_SSL=false

# Used when DATABASE_URL is not set (local development or a host with separate fields).
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tradingDB
DB_USER=postgres
DB_PASSWORD=Nha1213
DB_LOGGING=false

# Auth
TOKEN_SECRET=replace_with_a_long_random_secret
TOKEN_EXPIRES_IN=1d

# Comma-separated frontend origins. Leave empty only when intentionally allowing all origins.
CORS_ORIGINS=http://localhost:5173

# Deployment example:
# NODE_ENV=production
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/tradingDB
# DB_SSL=true
# CORS_ORIGINS=https://your-frontend-domain.example.com

# Optional seed media paths, relative to Project-backend/Public.
# SEED_IMAGE_PATH=image
# SEED_VIDEO_PATH=video
# SEED_PDF_PATH=pdf
# SEED_FORCE_MEDIA=false
# SEED_ADMIN_PASSWORD=
